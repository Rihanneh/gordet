Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www.gordet.fr -> gordet.fr (en HTTPS, une seule redirection)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # HTTP -> HTTPS. Les deux conditions evitent une boucle de redirection
  # si IONOS termine le TLS en amont et ne transmet pas %{HTTPS}.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Fallback SPA : React Router prend le relais sur tout ce qui
  # ne correspond pas a un fichier ou un dossier existant.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Assets hashes par Vite (nom-XXXXXXXX.ext) : le nom change a chaque
  # build, on peut donc cacher agressivement.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|jpe?g|png|webp|svg|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html n'est jamais hashe : sans ca, un nouveau deploiement
  # resterait invisible pour les visiteurs deja venus.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
